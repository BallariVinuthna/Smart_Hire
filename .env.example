# ==============================================================================
# SmartHire X - AI & RAG Configuration Template
# ==============================================================================

# Google Gemini API Key (for Response Generation & Semantic Embeddings)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here

# Pinecone Vector Database (for 768-dim Vector Embeddings & Similarity Retrieval)
# Obtain from Pinecone Console: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-rag-documents
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=default
PINECONE_HOST=

# Database Configuration (Spring Data JPA)
# Uses local H2 by default (jdbc:h2:file:./data/smarthiredb); override for MySQL:
# MYSQL_URL=jdbc:mysql://localhost:3306/smarthire_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# MYSQL_USER=root
# MYSQL_PASSWORD=root

# Server Configuration
SERVER_PORT=8080
